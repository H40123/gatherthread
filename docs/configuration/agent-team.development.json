        "x": 48,
        "y": 155,
        "target": null
      },
      {
        "id": "development.builder",
        "label": "开发员",
        "role": "在约定范围内实现需求。",
        "prompt": "先检查已有文件，再做聚焦改动并运行相关检查。报告实际修改的文件与测试结果。",
        "x": 360,
        "y": 45,
        "target": null
      },
      {
        "id": "development.reviewer",
        "label": "审查员",
        "role": "独立检查正确性和回归风险。",
        "prompt": "对照需求检查改动，指出具体问题和复现检查，并向协调员反馈。",
        "x": 360,
        "y": 265,
        "target": null
      }
    ],
    "edges": [
      {
        "id": "flow-1",
