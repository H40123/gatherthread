{
  "$id": "https://gatherthread.cn/schemas/agent-team.v1.schema.json",
  "title": "GatherThread Agent Team configuration",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://gatherthread.cn/schemas/agent-team.v1.schema.json"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "gatherthread.agent-team"
    },
    "draft": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "team_prompt": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        },
        "entry_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "nodes": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "role": {
                "default": "",
                "type": "string",
                "maxLength": 1000
              },
              "prompt": {
                "type": "string",
                "maxLength": 2000
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "target": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "local"
                          },
                          "runtime_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9._:-]+$"
                          },
                          "harness": {
                            "type": "string",
                            "enum": [
                              "codex",
                              "deepseek-harness"
                            ]
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "reasoning_effort": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          }
                        },
                        "required": [
                          "kind",
                          "runtime_id",
                          "harness",
                          "provider",
                          "model"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "shared"
                          },
                          "share_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9._:-]+$"
                          },
                          "share_revision": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "harness": {
                            "type": "string",
                            "enum": [
                              "codex",
                              "deepseek-harness"
                            ]
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "reasoning_effort": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          }
                        },
                        "required": [
                          "kind",
                          "share_id",
                          "share_revision",
                          "harness",
                          "provider",
                          "model"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "cloud"
                          },
                          "profile_id": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                          },
                          "include_code": {
                            "default": false,
                            "type": "boolean"
                          },
                          "api_config_revision": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          }
                        },
                        "required": [
                          "kind",
                          "profile_id",
                          "provider",
                          "model"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "x",
              "y",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "one_way",
                  "bidirectional"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "target",
              "direction"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "max_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "max_duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    }
  },
  "required": [
    "version",
    "kind",
    "draft",
    "max_calls",
    "max_duration_minutes"
  ],
  "additionalProperties": false
}
